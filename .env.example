# Run python -m dzmm_bot.manage init to generate secrets in .env.
DZMM_CORE_TOKEN=
DZMM_ADMIN_TOKEN=
DZMM_CORE_URL=http://127.0.0.1:18120
# For local testing; PostgreSQL is supported through SQLAlchemy.
DZMM_DATABASE_URL=sqlite:///data/core.sqlite3
DZMM_WORKER_MODE=simulate
# m0 = accounts only; ranch = buy/view/feed/harvest; full = sale and upgrade enabled.
DZMM_GAME_STAGE=full
# Comma-separated platform player IDs; empty means all enabled-room players.
DZMM_GAME_WHITELIST=
# Comma-separated platform player IDs allowed to administer game updates/announcements.
DZMM_GAME_ADMINS=
# PBKDF2 hash for private-chat /管理员登陆; keep the actual hash in the ignored .env or server secret file.
DZMM_GAME_ADMIN_LOGIN_PASSWORD_HASH=
DZMM_AUCTION_START_COOLDOWN_SECONDS=300
# World events stay disabled (0) until the harvest threshold and both cooldown rules are approved.
DZMM_WORLD_HARVEST_THRESHOLD=0
DZMM_WORLD_EVENT_PLAYER_COOLDOWN=0
DZMM_WORLD_EVENT_GLOBAL_COOLDOWN=0
DZMM_BROWSER_PROFILE=data/browser-profile
# Playwright-managed Chromium. Optional explicit alternatives: chrome/msedge.
DZMM_BROWSER_CHANNEL=chromium
DZMM_LOGIN_URL=https://www.ivorune.xyz/sign-in
DZMM_CHAT_URL=https://www.ivorune.xyz/chat?c=YOUR_GROUP_ID
DZMM_BOT_API_TOKEN=
DZMM_BOT_ID=
# Optional real user.getMe GET route, same-origin relative path only.
# Empty means observe the website's own user.getMe response.
DZMM_ME_PATH=
DZMM_ME_ID_FIELD=id
# Socket pacing (seconds). Global sends start at 0.2s and back off on platform rate limits.
DZMM_SOCKET_INITIAL_INTERVAL=0.2
DZMM_SOCKET_MIN_INTERVAL=0.2
DZMM_SOCKET_MAX_INTERVAL=60
DZMM_SOCKET_PRIVATE_INTERVAL=5
DZMM_SOCKET_SUCCESS_WINDOW=30
DZMM_SOCKET_SUCCESS_STEP=0.1
DZMM_SOCKET_RATE_COOLDOWN=60
DZMM_SOCKET_BACKOFF_FACTOR=2
DZMM_RACE_AUTO_ENABLED=true
DZMM_WEATHER_ENABLED=false
DZMM_RACE_TIMEZONE=Asia/Shanghai
# Race AI commentary is opt-in. Keep the key only in the ignored local .env/server secret file.
DZMM_RACE_COMMENTARY_AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=10
DZMM_RACE_COMMENTARY_MAX_CHARS=250
DZMM_RACE_COMMENTARY_MAX_CALLS_PER_RACE=20
