# Run python -m dzmm_bot.manage init to generate secrets in .env.
DZMM_CORE_TOKEN=
DZMM_ADMIN_TOKEN=
DZMM_CORE_URL=http://127.0.0.1:18120
# For local testing; PostgreSQL is supported through SQLAlchemy.
DZMM_DATABASE_URL=sqlite:///data/core.sqlite3
DZMM_WORKER_MODE=simulate
# m0 = accounts only; ranch = buy/view/feed/harvest; full = sale and upgrade enabled.
DZMM_GAME_STAGE=full
# Comma-separated platform player IDs; empty means all enabled-room players.
DZMM_GAME_WHITELIST=
DZMM_BROWSER_PROFILE=data/browser-profile
# Playwright-managed Chromium. Optional explicit alternatives: chrome/msedge.
DZMM_BROWSER_CHANNEL=chromium
DZMM_LOGIN_URL=https://www.ivorune.xyz/sign-in
DZMM_CHAT_URL=https://www.ivorune.xyz/chat?c=YOUR_GROUP_ID
DZMM_BOT_API_TOKEN=
DZMM_BOT_ID=
# Optional real user.getMe GET route, same-origin relative path only.
# Empty means observe the website's own user.getMe response.
DZMM_ME_PATH=
DZMM_ME_ID_FIELD=id
