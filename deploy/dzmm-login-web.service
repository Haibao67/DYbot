[Unit]
Description=Temporary DZMM login web viewer on loopback
Requires=dzmm-login-vnc.service
After=dzmm-login-vnc.service
PartOf=dzmm-display.service

[Service]
User=dzmmbot
Group=dzmmbot
ExecStart=/usr/bin/websockify --web=/usr/share/novnc/ 127.0.0.1:6080 127.0.0.1:5901
Restart=on-failure
RestartSec=2
UMask=0077
